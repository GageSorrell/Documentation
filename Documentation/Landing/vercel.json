{
  "buildCommand": "npm run build",
  "headers": [
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/llms.txt"
    },
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/docs/agent/:path*"
    },
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/docs/:path*.md"
    },
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/storybook/agent/:path*"
    }
  ],
  "installCommand": "npm install",
  "outputDirectory": "Distribution",
  "redirects": [],
  "rewrites": [
    {
      "destination": "https://documentation.invalid/docs",
      "source": "/docs"
    },
    {
      "destination": "https://documentation.invalid/docs/:path*",
      "source": "/docs/:path*"
    },
    {
      "destination": "https://storybook.invalid/storybook",
      "source": "/storybook"
    },
    {
      "destination": "https://storybook.invalid/storybook/:path*",
      "source": "/storybook/:path*"
    }
  ],
  "version": 2
}
