---
import Search from "@lucide/astro/icons/search";
import "@pagefind/default-ui/css/ui.css";
---

<button type="button" class="site-search-trigger" aria-label="Search" aria-keyshortcuts="Control+K Meta+K" data-search-open>
  <Search size={18} aria-hidden="true" />
  <kbd aria-hidden="true"><span>Ctrl</span><span>K</span></kbd>
</button>

<dialog class="docs-search-dialog" aria-labelledby="docs-search-title">
  <section class="docs-search-panel">
    <header class="docs-search-heading">
      <h2 id="docs-search-title">Search documentation</h2>
      <button type="button" class="docs-search-close" data-search-close aria-label="Close search">Esc</button>
    </header>
    <div id="docs-pagefind-search" aria-label="Search documentation"></div>
  </section>
</dialog>

<script>
  import { PagefindUI } from "@pagefind/default-ui";

  const dialog = document.querySelector<HTMLDialogElement>(".docs-search-dialog");
  let pagefind: PagefindUI | undefined;

  const openSearch = () => {
    if (dialog === null) return;
    if (!pagefind) {
      pagefind = new PagefindUI({
        bundlePath: "/docs/pagefind/",
        element: "#docs-pagefind-search",
        showImages: false
      });
    }
    if (!dialog.open) dialog.showModal();
    window.setTimeout(() => dialog.querySelector<HTMLInputElement>("input")?.focus(), 0);
  };

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest("[data-search-open]")) {
      openSearch();
    } else if (target.closest("[data-search-close]")) {
      dialog?.close();
    } else if (target === dialog) {
      dialog.close();
    }
  });

  document.addEventListener("keydown", (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      openSearch();
    }
  });
</script>

<style is:global>
  .site-search-trigger {
    appearance: none;
    align-items: center;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--border) 92%, var(--foreground) 8%);
    border-radius: .375rem;
    color: var(--muted-foreground);
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-size: .875rem;
    gap: .5rem;
    height: 2rem;
    line-height: 1.5;
    padding: .25rem .625rem;
    transition: background-color .15s, border-color .15s, color .15s;
    white-space: nowrap;
  }
  .site-search-trigger:hover, .site-search-trigger:focus-visible {
    background: var(--code-background);
    border-color: var(--border-strong);
    color: var(--foreground);
  }
  .site-search-trigger kbd {
    align-items: center;
    color: var(--muted-foreground);
    display: inline-flex;
    font: inherit;
    font-size: 12px;
    gap: .125rem;
    line-height: 1;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
  }
  .landing-header-actions .site-search-trigger { height: 2rem; width: auto; }
  .landing-mobile-menu .site-search-trigger { justify-content: flex-start; width: 100%; }
  .docs-search-dialog {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: .75rem;
    box-shadow: 0 24px 80px rgb(0 0 0 / .24);
    color: var(--foreground);
    margin: 10vh auto auto;
    max-height: 80vh;
    max-width: min(42rem, calc(100vw - 2rem));
    overflow: auto;
    padding: 0;
    width: 100%;
  }
  .docs-search-dialog::backdrop { background: rgb(9 9 11 / .56); backdrop-filter: blur(3px); }
  .docs-search-panel { padding: 1rem 1.25rem 1.25rem; }
  .docs-search-heading { align-items: center; display: flex; justify-content: space-between; margin-bottom: .75rem; }
  .docs-search-heading h2 { color: var(--foreground); font-size: .9rem; font-weight: 600; margin: 0; }
  .docs-search-close { background: transparent; border: 1px solid var(--border); border-radius: .375rem; color: var(--muted-foreground); cursor: pointer; font: inherit; font-size: .75rem; padding: .25rem .45rem; }
  .docs-search-close:hover, .docs-search-close:focus-visible { color: var(--foreground); }
  .docs-search-dialog .pagefind-ui {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--code-background);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: .5rem;
    --pagefind-ui-font: inherit;
  }
  .docs-search-dialog .pagefind-ui__search-input { font-size: 1rem; padding: .75rem 1rem; }
  .docs-search-dialog .pagefind-ui__result { padding-block: 1rem; }
  .docs-search-dialog .pagefind-ui__result-title { font-size: 1rem; }
  .docs-search-dialog .pagefind-ui__result-excerpt { font-size: .875rem; }
  @media (max-width: 700px) {
    .docs-search-dialog { margin: 5vh auto auto; max-height: 90vh; }
    .docs-search-panel { padding: .75rem; }
  }
</style>
