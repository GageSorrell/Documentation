---
import "@pagefind/default-ui/css/ui.css";
import { documentationSlug, docsPath, visibleDocumentationPages } from "@sorrell/docs-astro";
import { getCollection } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";

const copyText = "Search the Sorrell Documentation at https://docs.sorrell.sh/docs/search/";
const entries = await getCollection("documentation", ({ data }) => !data.draft);
const pages = visibleDocumentationPages(entries.map((entry) => ({ ...entry.data, id: entry.id, slug: documentationSlug(entry.id) })));
---

<DocsLayout
    canonicalPath={docsPath("/docs", "search")}
    copyText={copyText}
    description="Search articles and guides in the Sorrell Documentation."
    headings={[]}
    pages={pages}
    slug="search"
    title="Search"
>
    <div id="pagefind-search" aria-label="Documentation search"></div>
</DocsLayout>

<script>
    import { PagefindUI } from "@pagefind/default-ui";

    new PagefindUI({
        bundlePath: "/docs/pagefind/",
        element: "#pagefind-search",
        showImages: false
    });
</script>
