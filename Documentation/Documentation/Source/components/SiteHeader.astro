---
/**
 * Shared documentation header aligned with the public Landing header.
 *
 * @module @sorrell/documentation/components/SiteHeader
 * @file SiteHeader.astro
 */
import { documentationVersions } from "../Versions.js";

interface Props
{
    readonly currentVersion?: string | undefined;
    readonly slug?: string | undefined;
}

const { currentVersion, slug = "" } = Astro.props;
const versionHref = (versionId: string): string =>
    versionId === "current"
        ? `/docs/${slug}`
        : `/docs/${versionId}/${slug}`;
const navigation = [
    { label: "Docs", href: "/docs/" },
    { label: "Architecture", href: "/docs/architecture/" },
    { label: "Authoring", href: "/docs/authoring/" },
    { label: "API", href: "/docs/api/" },
    { label: "Storybook", href: "/storybook/" },
    {
        external: true,
        href: "https://github.com/GageSorrell/Documentation/tree/Master#ReadMe",
        label: "GitHub"
    }
];
---

<header class="landing-header">
    <div class="landing-container landing-header-inner">
        <a href="/" class="landing-brand" aria-label="sorrell-documentation home">
            <span>sorrell-documentation</span>
        </a>
        <nav class="landing-header-nav" aria-label="Primary navigation">
            {navigation.map((item) => <a
                href={item.href}
                {...item.external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
            >{item.label}</a>)}
        </nav>
        <div class="landing-header-actions">
            <button type="button" aria-label="Switch to dark theme" data-theme-toggle>
                <span data-theme-icon="light">
                    <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.463.402.807a6.5 6.5 0 0 0 8.268 8.268c.344-.215.829-.003.803.397" /></svg>
                </span>
                <span class="hidden" data-theme-icon="dark">
                    <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2m4.93-17.07-1.42 1.42M6.49 17.51l-1.42 1.42M22 12h-2M4 12H2m17.07 7.07-1.42-1.42M6.49 6.49 5.07 5.07" /></svg>
                </span>
            </button>
        </div>
        <details class="landing-mobile-menu">
            <summary aria-label="Open navigation"><span>Menu</span><span aria-hidden="true">+</span></summary>
            <nav aria-label="Mobile navigation">
                {navigation.map((item) => <a
                    href={item.href}
                    {...item.external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
                >{item.label}</a>)}
                <div class="landing-mobile-theme">
                    <span>Theme</span>
                    <button type="button" aria-label="Switch to dark theme" data-theme-toggle>
                        <span data-theme-icon="light">
                            <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.463.402.807a6.5 6.5 0 0 0 8.268 8.268c.344-.215.829-.003.803.397" /></svg>
                        </span>
                        <span class="hidden" data-theme-icon="dark">
                            <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2m4.93-17.07-1.42 1.42M6.49 17.51l-1.42 1.42M22 12h-2M4 12H2m17.07 7.07-1.42-1.42M6.49 6.49 5.07 5.07" /></svg>
                        </span>
                    </button>
                </div>
            </nav>
        </details>
    </div>
</header>

{currentVersion === undefined ? null : <nav class="site-version-nav" aria-label="Documentation versions">
    <span>Version</span>
    {documentationVersions.map((item) => <a
        aria-current={(currentVersion === item.id || (currentVersion === "current" && item.id === "current")) ? "page" : undefined}
        href={versionHref(item.id)}
    >{item.label}</a>)}
</nav>}

<script is:inline>
    (() => {
        const themeKey = "sorrell-docs-theme";
        const updateThemeToggles = () => {
            const dark = document.documentElement.dataset.theme === "dark";
            document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
                button.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
                button.querySelector("[data-theme-icon='light']")?.classList.toggle("hidden", dark);
                button.querySelector("[data-theme-icon='dark']")?.classList.toggle("hidden", !dark);
            });
        };
        const applyTheme = (theme, persist = false) => {
            document.documentElement.dataset.theme = theme;
            document.documentElement.classList.toggle("dark", theme === "dark");
            document.documentElement.style.colorScheme = theme;
            if (persist) {
                try { localStorage.setItem(themeKey, theme); } catch { /* Storage can be unavailable in restricted contexts. */ }
            }
            updateThemeToggles();
        };
        let storedTheme = null;
        try { storedTheme = localStorage.getItem(themeKey); } catch { /* Storage can be unavailable in restricted contexts. */ }
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        applyTheme(storedTheme === "light" || storedTheme === "dark" ? storedTheme : systemDark ? "dark" : "light");
        document.addEventListener("click", (event) => {
            const target = event.target;
            if (!(target instanceof Element) || target.closest("[data-theme-toggle]") === null) return;
            applyTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark", true);
        });
        window.addEventListener("storage", (event) => {
            if (event.key === themeKey && (event.newValue === "light" || event.newValue === "dark")) applyTheme(event.newValue);
        });
    })();
</script>

<style is:global>
    .landing-container { width: min(100% - 2rem, 72rem); margin-inline: auto; }
    .landing-header { position: sticky; top: 0; z-index: 40; border-bottom: 1px solid var(--docs-border); background: color-mix(in oklch, var(--docs-background) 92%, transparent); backdrop-filter: blur(14px); }
    .landing-header-inner { display: flex; min-height: 4rem; align-items: center; gap: 2rem; }
    .landing-brand { display: inline-flex; align-items: center; flex: 0 0 auto; }
    .landing-header-nav { display: flex; align-items: center; gap: 1.35rem; font-size: .875rem; color: var(--docs-muted); }
    .landing-header-nav a:hover, .landing-header-nav a:focus-visible { color: var(--docs-foreground); }
    .landing-header-actions { margin-left: auto; display: flex; align-items: center; }
    .landing-header-actions button, .landing-mobile-theme button { display: inline-flex; height: 2.25rem; width: 2.25rem; align-items: center; justify-content: center; border: 0; border-radius: .375rem; background: transparent; color: var(--docs-foreground); cursor: pointer; transition: background-color .15s; }
    .landing-header-actions button:hover, .landing-mobile-theme button:hover { background: var(--docs-code-background); }
    .landing-mobile-menu { display: none; margin-left: auto; position: relative; }
    .landing-mobile-menu summary { display: flex; align-items: center; gap: .5rem; cursor: pointer; list-style: none; border: 1px solid var(--docs-border); border-radius: .45rem; padding: .5rem .7rem; font-size: .875rem; color: var(--docs-foreground); }
    .landing-mobile-menu summary::-webkit-details-marker { display: none; }
    .landing-mobile-menu nav { position: absolute; right: 0; top: 3rem; display: grid; min-width: 12rem; gap: .25rem; padding: .5rem; border: 1px solid var(--docs-border); border-radius: .65rem; background: var(--docs-background); box-shadow: 0 1rem 2rem color-mix(in oklch, var(--docs-foreground) 14%, transparent); }
    .landing-mobile-menu nav a { border-radius: .4rem; padding: .65rem .75rem; color: var(--docs-foreground); }
    .landing-mobile-menu nav a:hover, .landing-mobile-menu nav a:focus-visible { background: var(--docs-code-background); }
    .landing-mobile-theme { display: flex; align-items: center; justify-content: space-between; margin-top: .35rem; border-top: 1px solid var(--docs-border); padding: .4rem .25rem 0 .75rem; color: var(--docs-muted); font-size: .875rem; }
    .landing-mobile-theme button { margin: -.3rem; }
    .site-version-nav { display: flex; width: min(100% - 2rem, 72rem); align-items: center; gap: .35rem; margin: .75rem auto 0; font-size: .8rem; }
    .site-version-nav > span { color: var(--docs-muted); margin-right: .25rem; }
    .site-version-nav a { border: 1px solid var(--docs-border); border-radius: .3rem; color: var(--docs-muted); padding: .3rem .5rem; }
    .site-version-nav a[aria-current="page"] { background: var(--docs-code-background); color: var(--docs-foreground); }
    .hidden { display: none; }
    @media (max-width: 800px) {
        .landing-header-nav, .landing-header-actions { display: none; }
        .landing-mobile-menu { display: block; }
    }
    @media (max-width: 560px) {
        .landing-container, .site-version-nav { width: min(100% - 1.25rem, 72rem); }
    }
</style>
