{
  "headers": [
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/docs/agent/:path*"
    },
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/docs/:path*.md"
    },
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/docs/llms.txt"
    },
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/docs/llms-full.txt"
    },
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/docs/:version/llms.txt"
    },
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/docs/:version/llms-full.txt"
    }
  ],
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "version": 2
}
